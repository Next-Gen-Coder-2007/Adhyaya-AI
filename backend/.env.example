# Backend Environment Variables (Vercel & Local)
# When deploying to Vercel, set CLIENT_URL to your deployed frontend URL: https://your-frontend.vercel.app

PORT=8000
NODE_ENV=production
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/adhyaya_ai
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_URL=https://www.googleapis.com/oauth2/v3/userinfo
YOUTUBE_API_KEY=your_youtube_api_key_here
